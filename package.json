{
  "name": "oil-wos-tools",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "capture:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/capture-ldplayer.ps1 -OutFile tools/screenshots/latest.png",
    "scan:safe": "node tools/safe-rally-monitor.js --once --image tools/screenshots/latest.png",
    "scan:publish": "node tools/safe-rally-monitor.js --once --image tools/screenshots/latest.png --publish",
    "check:supabase": "node tools/check-supabase.js",
    "clear:ocr": "node tools/clear-ocr-rallies.js",
    "watch:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/watch-safe.ps1"
  },
  "dependencies": {
    "tesseract.js": "^6.0.1"
  }
}
